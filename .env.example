# AWS Configuration Example
# 
# Copy this file to .env and fill in your AWS credentials
# NEVER commit .env to version control!

# AWS Credentials
# Get these from AWS IAM Console
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here
AWS_DEFAULT_REGION=ap-southeast-2

# Optional: AWS Session Token (if using temporary credentials)
# AWS_SESSION_TOKEN=your_session_token_here

# Optional: Bedrock Configuration
# BEDROCK_MODEL_ID=au.anthropic.claude-sonnet-4-5-20250929-v1:0
# BEDROCK_REGION=ap-southeast-2
